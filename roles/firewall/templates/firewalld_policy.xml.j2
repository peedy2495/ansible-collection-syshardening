<?xml version="1.0" encoding="utf-8"?>
<policy target="{% if firewall_firewalld_policy_target == 'continue' %}CONTINUE{% else %}{{ firewall_firewalld_policy_target_by_action[firewall_firewalld_policy_target] }}{% endif %}" priority="-500">
  <ingress-zone name="{{ firewall_firewalld_policy_ingress }}"/>
  <egress-zone name="{{ firewall_firewalld_policy_egress }}"/>
  <short>Ansible {{ firewall_firewalld_policy_direction }} policy</short>
  <description>Managed by peedy2495.syshardening.firewall.</description>
{% for firewall_rule in firewall_firewalld_policy_rules if firewall_rule.get('state', 'present') == 'present' %}
  <rule>
{% if firewall_rule.get('source', 'any') != 'any' %}
    <source address="{{ firewall_rule.source | e }}"/>
{% endif %}
{% if firewall_rule.get('destination', 'any') != 'any' %}
    <destination address="{{ firewall_rule.destination | e }}"/>
{% endif %}
{% if firewall_rule.destination_port is defined %}
    <port port="{{ firewall_rule.destination_port }}" protocol="{{ firewall_rule.protocol }}"/>
{% elif firewall_rule.source_port is defined %}
    <source-port port="{{ firewall_rule.source_port }}" protocol="{{ firewall_rule.protocol }}"/>
{% elif firewall_rule.get('protocol', 'any') != 'any' %}
    <protocol value="{{ firewall_rule.protocol }}"/>
{% endif %}
{% if firewall_rule.get('log', false) %}
    <log prefix="ansible-firewall"/>
{% endif %}
    <{{ firewall_firewalld_rule_action_by_action[firewall_rule.action] }}/>
  </rule>
{% endfor %}
</policy>
